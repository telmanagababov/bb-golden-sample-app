{
  "name": "shared-feature-error-reports",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/shared/feature/error-reports/src",
  "prefix": "bb",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/feature/error-reports/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/shared/feature/error-reports/**/*.ts",
          "libs/shared/feature/error-reports/**/*.html"
        ]
      }
    }
  },
  "tags": ["scope:shared", "type:feature"]
}